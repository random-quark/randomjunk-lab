#!/usr/bin/env bash
set -euo pipefail

umask 077

ENV_FILE=/root/.restic-env
LOG_FILE=/var/log/restic-backup.log
LOCK_FILE=/run/lock/restic-backup.lock
DUMP_DIR=/var/backups/db
EXCLUDE_FILE=/etc/restic-backup-excludes

if [ ! -e "$LOG_FILE" ]; then
  install -o root -g root -m 0600 /dev/null "$LOG_FILE"
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  printf '%s %s\n' "$(date --iso-8601=seconds)" "Another backup is already running; exiting." >> "$LOG_FILE"
  exit 0
fi

exec > >(
  while IFS= read -r line; do
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$line"
  done | tee -a "$LOG_FILE"
) 2>&1

# Optional root-owned configuration; never commit the ping URL.
HEALTHCHECKS_PING_URL=
healthchecks_ping() {
  local suffix="$1"
  [ -n "$HEALTHCHECKS_PING_URL" ] || return 0
  # Supply the bearer URL on stdin, never in process arguments or logs.
  if ! printf 'url = "%s%s"\n' "$HEALTHCHECKS_PING_URL" "$suffix" |
    curl --config - --silent --fail --output /dev/null \
      --connect-timeout 5 --max-time 10 --retry 2 --retry-max-time 30 2>/dev/null; then
    printf '%s\n' 'Warning: Healthchecks status delivery failed.'
  else
    printf 'Healthchecks signal delivered: %s\n' "${suffix:-success}"
  fi
  return 0
}

success=false
staging_dir=
cleanup() {
  exit_code=$?
  trap - EXIT
  set +e
  if [ -n "$staging_dir" ] && [ -d "$staging_dir" ]; then
    find "$staging_dir" -depth -delete
  fi
  if [ "$success" = true ]; then
    printf '%s\n' 'Backup completed successfully.'
    healthchecks_ping ''
  else
    [ "$exit_code" -ne 0 ] || exit_code=1
    printf 'Backup failed with exit code %s.\n' "$exit_code"
    healthchecks_ping /fail
  fi
  exit "$exit_code"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [ -f /root/.restic-healthchecks.env ]; then
  source /root/.restic-healthchecks.env
  if [[ ! "$HEALTHCHECKS_PING_URL" =~ ^https://hc-ping\.com/[0-9a-fA-F-]{36}$ ]]; then
    HEALTHCHECKS_PING_URL=
    printf '%s\n' 'Invalid Healthchecks configuration.'
    exit 1
  fi
fi
healthchecks_ping /start

printf '%s\n' 'Starting Restic backup.'

# shellcheck disable=SC1090
source "$ENV_FILE"
: "${AWS_ACCESS_KEY_ID:?missing AWS_ACCESS_KEY_ID}"
: "${AWS_SECRET_ACCESS_KEY:?missing AWS_SECRET_ACCESS_KEY}"
: "${RESTIC_REPOSITORY:?missing RESTIC_REPOSITORY}"
: "${RESTIC_PASSWORD_FILE:?missing RESTIC_PASSWORD_FILE}"

install -d -o root -g root -m 0700 /var/backups
staging_dir=$(mktemp -d /var/backups/.restic-db.XXXXXX)
install -d -o root -g root -m 0700 "$staging_dir/postgresql" "$staging_dir/sqlite"

if systemctl is-active --quiet postgresql && command -v pg_dumpall >/dev/null 2>&1; then
  printf '%s\n' 'Creating compressed PostgreSQL logical dump.'
  runuser -u postgres -- pg_dumpall --clean --if-exists | gzip -9 > "$staging_dir/postgresql/all.sql.gz"
else
  printf '%s\n' 'PostgreSQL is not active or pg_dumpall is unavailable; no PostgreSQL dump created.'
fi

printf '%s\n' 'Discovering and snapshotting SQLite databases.'
python3 - "$staging_dir/sqlite" <<'PYTHON'
import gzip
import hashlib
import os
from pathlib import Path
import shutil
import sqlite3
import sys
import urllib.parse

destination = Path(sys.argv[1])
roots = [Path(path) for path in ("/srv", "/home", "/root", "/opt", "/var/www") if Path(path).exists()]
pruned_names = {".cache", ".codex", ".venv", "__pycache__", "node_modules", "browsers"}
suffixes = {".db", ".sqlite", ".sqlite3"}
manifest = []
errors = []

for root in roots:
    for current, directories, files in os.walk(root):
        directories[:] = [name for name in directories if name not in pruned_names]
        for filename in files:
            source = Path(current, filename)
            if source.suffix.lower() not in suffixes:
                continue
            try:
                with source.open("rb") as handle:
                    if handle.read(16) != b"SQLite format 3\x00":
                        continue
                digest = hashlib.sha256(os.fsencode(str(source))).hexdigest()[:16]
                output_name = f"{digest}-{source.name}.gz"
                temporary = destination / f".{digest}-{source.name}"
                output = destination / output_name
                uri = "file:" + urllib.parse.quote(str(source), safe="/") + "?mode=ro"
                with sqlite3.connect(uri, uri=True) as input_db, sqlite3.connect(temporary) as output_db:
                    input_db.backup(output_db)
                    output_db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
                    output_db.execute("PRAGMA journal_mode=DELETE")
                    result = output_db.execute("PRAGMA quick_check").fetchone()
                    if not result or result[0] != "ok":
                        raise RuntimeError(f"quick_check returned {result!r}")
                for sidecar_suffix in ("-wal", "-shm"):
                    Path(str(temporary) + sidecar_suffix).unlink(missing_ok=True)
                with temporary.open("rb") as source_file, gzip.open(output, "wb", compresslevel=9) as output_file:
                    shutil.copyfileobj(source_file, output_file)
                temporary.unlink()
                manifest.append((output_name, str(source)))
                print(f"SQLite snapshot: {source}")
            except Exception as error:
                errors.append(f"{source}: {error}")

with (destination / "manifest.tsv").open("w", encoding="utf-8") as handle:
    for output_name, source_name in manifest:
        handle.write(f"{output_name}\t{source_name}\n")

if errors:
    for error in errors:
        print(f"SQLite snapshot failed: {error}", file=sys.stderr)
    raise SystemExit(1)
PYTHON

install -d -o root -g root -m 0700 "$DUMP_DIR"
find "$DUMP_DIR" -mindepth 1 -depth -delete
cp -a "$staging_dir"/. "$DUMP_DIR"/
find "$staging_dir" -depth -delete
staging_dir=

printf '%s\n' 'Uploading filesystem snapshot.'
restic backup / --exclude-caches --exclude-file="$EXCLUDE_FILE" --tag server1

printf '%s\n' 'Applying retention policy and pruning unneeded repository data.'
restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune

printf '%s\n' 'Checking 1% of repository data.'
restic check --read-data-subset=1%

success=true
