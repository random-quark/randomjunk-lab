#!/usr/bin/env bash
set -euo pipefail
YES=0
if [[ ${1:-} == --yes || ${1:-} == -y ]]; then YES=1; shift; fi
[[ $# -eq 1 ]] || { echo 'usage: labrm [--yes] NAME' >&2; exit 2; }
if [[ $YES -eq 0 ]]; then
  read -r -p "Type $1 to confirm removal: " answer
  [[ $answer == "$1" ]] || exit 1
fi
exec sudo /usr/local/sbin/labctl remove "$1"
