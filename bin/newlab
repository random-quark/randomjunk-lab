#!/usr/bin/env bash
#
# newlab — create an experiment: directory, subdomain, HTTPS, optional database,
#          optional service. Records every resource before creating it, and
#          rolls back completely if any step fails.
#
#   newlab tetris --static
#   newlab blog --app --db sqlite
#   newlab notes --app --db postgres --private --secrets OPENAI_API_KEY
#
# It does NOT notify anyone. Scaffolding is not a working app — notify only
# after the requested behaviour actually works. See CLAUDE.md.
#
set -euo pipefail
. /usr/local/lib/lab/labcommon.sh

TEMPLATES=/usr/local/share/lab/templates
RENDER=/usr/local/lib/lab/render.py

NAME=""; KIND="static"; DB="none"; PRIVATE=0; TITLE=""; SECRETS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --static)  KIND=static; shift ;;
    --app)     KIND=app; shift ;;
    --db)      DB=${2:-}; shift 2 ;;
    --db=*)    DB=${1#*=}; shift ;;
    --private) PRIVATE=1; shift ;;
    --title)   TITLE=${2:-}; shift 2 ;;
    --secrets) SECRETS=${2:-}; shift 2 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    -*)        die "unknown flag: $1" ;;
    *)         [[ -z $NAME ]] || die "unexpected argument: $1"; NAME=$1; shift ;;
  esac
done

# ---- validate everything before touching anything ----------------------------
[[ -n $NAME ]] || die "usage: newlab <name> [--static|--app] [--db none|sqlite|postgres] [--private] [--secrets K,K]"
valid_name "$NAME" || die "invalid name '$NAME': 2-31 chars, lowercase letters, digits and inner hyphens only"
[[ $DB =~ ^(none|sqlite|postgres)$ ]] || die "--db must be none, sqlite or postgres"
[[ $KIND == app || $DB == none ]] || die "--db needs --app (a static site has no backend)"
[[ $KIND == app || -z $SECRETS ]] || die "--secrets needs --app"
[[ -z $SECRETS || $SECRETS =~ ^[A-Z0-9_,]+$ ]] || die "--secrets must be comma-separated KEY names"
[[ -n $TITLE ]] || TITLE=$NAME

DOMAIN=$(domain)
[[ $DOMAIN =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] \
  || die "invalid domain in $LAB_ROOT/.domain: '$DOMAIN'"

APP_DIR="$LAB_ROOT/$NAME"
URL="https://$NAME.$DOMAIN"
STAGED="$STATE_DIR/$NAME.caddy.staged"

with_lock
[[ ! -e $APP_DIR ]]                   || die "$APP_DIR already exists"
[[ ! -e /etc/caddy/sites/$NAME.caddy ]] || die "a Caddy site for '$NAME' already exists"
[[ ! -f $(record_path "$NAME") ]]     || die "a resource record for '$NAME' already exists — run 'labrm $NAME' first"

# ---- roll back completely on any failure -------------------------------------
cleanup_on_failure() {
  local rc=$?
  [[ $rc -eq 0 ]] && return 0
  warn "creation failed (exit $rc) — rolling back"
  record_state "$NAME" "create-failed" 2>/dev/null || true
  labrm --force "$NAME" >&2 || warn "rollback incomplete — run 'labdoctor' and inspect $(record_path "$NAME")"
  exit $rc
}
trap cleanup_on_failure EXIT

record_init "$NAME" "$KIND" "$DB" "$PRIVATE"

# ---- directory + service identity --------------------------------------------
info "Creating $APP_DIR"
$LABCTL service-create "$NAME" >/dev/null   # makes the user, dir, env file, drop-in
record_set "$NAME" service_identity true

cp -r "$TEMPLATES/$KIND/." "$APP_DIR/"
python3 "$RENDER" "$APP_DIR" "NAME=$NAME" "TITLE=$TITLE" "URL=$URL" "DOMAIN=$DOMAIN"
record_set "$NAME" directory "$APP_DIR"

# Raster icons: the manifest references PNGs, and iOS ignores SVG icons for
# home-screen install. Generated from icon.svg so there is one source of truth.
if command -v rsvg-convert >/dev/null 2>&1; then
  for spec in 180 192 512; do
    rsvg-convert -w "$spec" -h "$spec" "$APP_DIR/public/icon.svg" \
      -o "$APP_DIR/public/icon-${spec}.png"
  done
  cp "$APP_DIR/public/icon-512.png" "$APP_DIR/public/icon-maskable-512.png"
else
  warn "rsvg-convert missing — PNG icons not generated; PWA install will fall back to the SVG"
fi

PORT=""
if [[ $KIND == app ]]; then
  PORT=$(alloc_port "$NAME")
  record_set "$NAME" port "$PORT"
  info "Assigned port $PORT"
fi

# ---- database ----------------------------------------------------------------
case "$DB" in
  postgres)
    info "Creating Postgres database"
    $LABCTL db-create "$NAME"          # writes DATABASE_URL into the app env file
    record_set "$NAME" database "postgres"
    ;;
  sqlite)
    # data/ is the only app-writable directory; the DB lives there.
    record_set "$NAME" database "sqlite"
    ;;
esac

# ---- secrets -----------------------------------------------------------------
if [[ -n $SECRETS ]]; then
  info "Granting secrets: $SECRETS"
  $LABCTL secrets-grant "$SECRETS" "$NAME"
  record_set "$NAME" secrets "$SECRETS"
fi

# ---- python environment ------------------------------------------------------
if [[ $KIND == app ]]; then
  info "Building Python environment"
  {
    echo "APP_NAME=$NAME"
    echo "PORT=$PORT"
    [[ $DB == sqlite ]] && echo "DATABASE_URL=sqlite:///$APP_DIR/data/$NAME.db"
  } > "$APP_DIR/.env"
  chmod 640 "$APP_DIR/.env"

  # System interpreter, explicitly: a uv-managed Python under /root or a home
  # directory would be unreachable with ProtectHome=true in the unit.
  ( cd "$APP_DIR"
    [[ $DB == postgres ]] && sed -i 's/^# psycopg/psycopg/' pyproject.toml
    UV_PYTHON_DOWNLOADS=never uv venv --quiet --python /usr/bin/python3 .venv
    UV_PYTHON_DOWNLOADS=never uv sync --quiet --frozen 2>/dev/null \
      || UV_PYTHON_DOWNLOADS=never uv sync --quiet   # first run has no lockfile yet
  )
  record_set "$NAME" venv true
fi

# ---- caddy site --------------------------------------------------------------
info "Deploying Caddy site"
AUTH=""
if [[ $PRIVATE -eq 1 ]]; then
  PASS=$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)
  HASH=$(caddy hash-password --plaintext "$PASS")
  # Password goes to a private file, never into install.md or git.
  umask 077
  printf 'user: lab\npassword: %s\n' "$PASS" > "$STATE_DIR/$NAME.secret"
  umask 022
  AUTH=$'\tbasic_auth {\n\t\tlab '"$HASH"$'\n\t}'
  record_set "$NAME" private true
fi

{
  printf '# %s — generated by newlab %s\n' "$NAME" "$(date -Iseconds)"
  printf '%s.%s {\n' "$NAME" "$DOMAIN"
  printf '\tencode gzip\n'
  if [[ $KIND == static ]]; then
    printf '\troot * %s/public\n\tfile_server\n' "$APP_DIR"
  else
    printf '\treverse_proxy 127.0.0.1:%s\n' "$PORT"
  fi
  [[ -n $AUTH ]] && printf '%s\n' "$AUTH"
  printf '}\n'
} > "$STAGED"

$LABCTL caddy-deploy "$STAGED" "$NAME"
rm -f "$STAGED"
record_set "$NAME" caddy_site "/etc/caddy/sites/$NAME.caddy"

# ---- service -----------------------------------------------------------------
if [[ $KIND == app ]]; then
  info "Starting service"
  $LABCTL service enable "$NAME"
  record_set "$NAME" service enabled
  if ! wait_http "http://127.0.0.1:$PORT/api/health" 45; then
    $LABCTL logs "$NAME" >&2 || true
    die "service did not become healthy on port $PORT"
  fi
fi

# ---- readiness ---------------------------------------------------------------
# Certificate issuance happens as soon as the hostname is configured, but the
# first public request can still be a few seconds behind it.
info "Waiting for public HTTPS"
if wait_http "$URL" 120; then
  record_set "$NAME" https ok
else
  warn "the public URL is not answering yet — check 'sudo /usr/local/sbin/labctl logs $NAME' and 'journalctl -u caddy'"
  record_set "$NAME" https pending
fi

# ---- bookkeeping -------------------------------------------------------------
record_state "$NAME" "created"
python3 - "$(record_path "$NAME")" "$APP_DIR/install.md" "$URL" <<'PY'
import json, sys
rec, out, url = sys.argv[1], sys.argv[2], sys.argv[3]
d = json.load(open(rec))
r = d["resources"]
name = d["name"]
lines = [
    f"# {name} — what exists, and where",
    "",
    f"Generated from `/srv/lab/.state/{name}.json`, which is the authoritative",
    "record. Regenerate with `labdoctor --write-install-md`.",
    "",
    f"- URL: {url}",
    f"- Type: {d['kind']}",
    f"- Created: {d['created']}",
    f"- Directory: `/srv/lab/{name}/`",
]
if r.get("caddy_site"): lines.append(f"- Caddy site: `{r['caddy_site']}`")
if r.get("port"):       lines.append(f"- Port: {r['port']} (registered in `/srv/lab/ports.tsv`)")
if r.get("service"):    lines.append(f"- systemd unit: `lab-app@{name}.service`, running as user `labapp-{name}`")
if d.get("db") == "postgres":
    lines.append(f"- Postgres database `lab_{name.replace('-','_')}` and role of the same name")
if d.get("db") == "sqlite":
    lines.append(f"- SQLite database in `/srv/lab/{name}/data/`")
if r.get("secrets"):    lines.append(f"- Secrets granted: {r['secrets']} (values in `/etc/lab/apps/{name}.env`, root-owned)")
if d.get("private"):    lines.append(f"- HTTP basic auth — credentials in `/srv/lab/.state/{name}.secret` (not in git)")
lines += [
    "",
    "## Anything added later",
    "",
    "**Record it here.** System packages, cron jobs or timers, B2 buckets,",
    "external accounts or API keys registered, webhooks — anything created",
    "outside this directory. System packages are shared: note them here and",
    "tell Theo, but do NOT remove them during teardown, since another",
    "experiment may depend on them.",
    "",
    "_None recorded yet._",
    "",
    "## Removal",
    "",
    f"    labrm {name}",
    "",
    "This removes the service, per-app user, Caddy site, database, port",
    "registration and directory. It does NOT remove retained backups (see the",
    "restic retention policy) or PWA state already installed on a phone.",
    "",
]
open(out, "w").write("\n".join(lines))
PY

( cd "$APP_DIR"
  git init -q
  cat > .gitignore <<'GI'
.venv/
data/
.env
__pycache__/
GI
  git add -A
  git -c user.email=lab@localhost -c user.name=newlab commit -qm "newlab: scaffold $NAME"
)

trap - EXIT
info "Created: $URL"
[[ $PRIVATE -eq 1 ]] && info "Basic auth credentials: $STATE_DIR/$NAME.secret"
echo
echo "This is scaffolding, not a working app. Build the requested behaviour,"
echo "verify it, then notify with:  notify \"$NAME is ready\" \"$URL\""
