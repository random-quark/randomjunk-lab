#!/usr/bin/env bash
# labs — list experiments, their state and their age.
set -euo pipefail
. /usr/local/lib/lab/labcommon.sh
DOMAIN=$(domain 2>/dev/null || echo '?')
printf '%-18s %-7s %-6s %-11s %-5s %s\n' NAME TYPE PORT SERVICE AGE URL
shopt -s nullglob
for rec in "$STATE_DIR"/*.json; do
  name=$(basename "$rec" .json)
  kind=$(record_get "$name" kind)
  port=$(record_get "$name" resources.port); port=${port:-–}
  created=$(record_get "$name" created)
  state=$(record_get "$name" state)
  if [[ $kind == app ]]; then
    svc=$($LABCTL service is-active "$name" 2>/dev/null || echo unknown)
  else
    svc=static
  fi
  [[ $state != created ]] && svc="$state"
  age=$(( ( $(date +%s) - $(date -d "$created" +%s) ) / 86400 ))
  printf '%-18s %-7s %-6s %-11s %-5s https://%s.%s\n' \
    "$name" "$kind" "$port" "$svc" "${age}d" "$name" "$DOMAIN"
done
