#!/usr/bin/env bash
# notify — push a message to Theo's phone via ntfy, as the lab (agent) user.
#
# Config lives in /etc/lab/notify.env (root:lab 0640).
# Hosted topic names are access secrets; do not print them.
# The BACKUP job does not use this path — see /usr/local/bin/lab-notify-root.
set -euo pipefail
CONF=/etc/lab/notify.env
[[ -r $CONF ]] || { echo "notify: cannot read $CONF" >&2; exit 1; }

NTFY_URL=""; NTFY_TOPIC=""
# Parse strictly; never source a config file as shell.
while IFS='=' read -r k v; do
  case "$k" in
    NTFY_URL)   NTFY_URL=$v ;;
    NTFY_TOPIC) NTFY_TOPIC=$v ;;
  esac
done < <(grep -E '^(NTFY_URL|NTFY_TOPIC)=' "$CONF")

[[ -n $NTFY_TOPIC && $NTFY_TOPIC != CHANGE-ME* ]] || {
  echo "notify: NTFY_TOPIC not configured in $CONF" >&2; exit 1; }

TITLE=${1:-lab}
BODY=${2:-}
CLICK=${3:-}
# Preserve existing notify TITLE URL callers; prose bodies need an explicit URL.
if [[ $# -lt 3 && $BODY =~ ^https?://[^[:space:]]+$ ]]; then
  CLICK=$BODY
fi
if [[ -n $CLICK && ! $CLICK =~ ^https?://[^[:space:]]+$ ]]; then
  echo "notify: click destination must be an http(s) URL without whitespace" >&2
  exit 1
fi
if [[ $TITLE == *$'\n'* || $TITLE == *$'\r'* ]]; then
  echo "notify: title must be a single line" >&2
  exit 1
fi
headers=(-H "Title: $TITLE" -H "Tags: white_check_mark")
[[ -z $CLICK ]] || headers+=(-H "Click: $CLICK")
curl -fsS --connect-timeout 5 --max-time 15 "${headers[@]}" \
  --data-raw "$BODY" "${NTFY_URL:-https://ntfy.sh}/$NTFY_TOPIC" >/dev/null
