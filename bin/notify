#!/usr/bin/env bash
# notify — push a message to Theo's phone via ntfy, as the lab (agent) user.
#
# Config lives in /etc/lab/notify.env (root:lab 0640).
# Hosted topic names are access secrets; do not print them.
# The BACKUP job does not use this path — see /usr/local/bin/lab-notify-root.
set -euo pipefail
CONF=/etc/lab/notify.env
[[ -r $CONF ]] || { echo "notify: cannot read $CONF" >&2; exit 1; }

NTFY_URL=""; NTFY_TOPIC=""
# Parse strictly; never source a config file as shell.
while IFS='=' read -r k v; do
  case "$k" in
    NTFY_URL)   NTFY_URL=$v ;;
    NTFY_TOPIC) NTFY_TOPIC=$v ;;
  esac
done < <(grep -E '^(NTFY_URL|NTFY_TOPIC)=' "$CONF")

[[ -n $NTFY_TOPIC && $NTFY_TOPIC != CHANGE-ME* ]] || {
  echo "notify: NTFY_TOPIC not configured in $CONF" >&2; exit 1; }

TITLE=${1:-lab}
BODY=${2:-}
LINK=${3:-}
# Preserve existing notify TITLE URL callers; prose bodies need an explicit URL.
if [[ $# -lt 3 && $BODY =~ ^https?://[^[:space:]]+$ ]]; then
  LINK=$BODY
fi
if [[ -n $LINK && ! $LINK =~ ^https?://[^[:space:]]+$ ]]; then
  echo "notify: link must be an http(s) URL without whitespace" >&2
  exit 1
fi
if [[ $TITLE == *$'\n'* || $TITLE == *$'\r'* ]]; then
  echo "notify: title must be a single line" >&2
  exit 1
fi
# JSON safely preserves commas/quotes in URLs and action values.
# Link notifications deliberately contain only the URL and no click override.
python3 - "$NTFY_TOPIC" "$TITLE" "$BODY" "$LINK" <<'PAYLOAD' | \
  curl -fsS --connect-timeout 5 --max-time 15 -H 'Content-Type: application/json' \
  --data-binary @- "${NTFY_URL:-https://ntfy.sh}/" >/dev/null
import json, sys
topic, title, body, link = sys.argv[1:]
payload = {'topic': topic, 'title': title, 'message': link or body,
           'tags': ['white_check_mark']}
if link:
    payload['actions'] = [
        {'action': 'copy', 'label': 'Copy link', 'value': link},
        {'action': 'view', 'label': 'Open in browser', 'url': link},
    ]
print(json.dumps(payload))
PAYLOAD
