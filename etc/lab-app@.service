# Base identity is unprivileged even without the provisioning drop-in.
[Unit]
Description=lab experiment %i
After=network.target postgresql.service
ConditionPathExists=/etc/systemd/system/lab-app@%i.service.d/identity.conf

[Service]
Type=simple
User=labapp-%i
Group=labapp-%i
WorkingDirectory=/srv/lab/%i/app
EnvironmentFile=/etc/lab/apps/%i.env
ExecStart=/srv/lab/%i/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port ${PORT}
Restart=on-failure
RestartSec=3
UMask=0077
KillMode=control-group
TimeoutStopSec=30
MemoryMax=512M
TasksMax=64
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/lab/%i/data
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
